          }
        ]
      ]
    },
    "Checar Status Workflow": {
      "main": [
        [
          {
            "node": "Auditoria Gold (Postgres)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auditoria Gold (Postgres)": {
      "main": [
        [
          {
            "node": "Validar Sucesso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar Sucesso": {
      "main": [
        [
          {
            "node": "Resumo Sucesso",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Resumo Falha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
