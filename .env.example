# Conexão PostgreSQL / Supabase (Opcional para execução local em DuckDB/Parquet, obrigatório para persistência no Lakehouse)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Configurações do Pipeline
LOG_LEVEL=INFO
OUTPUT_DIR=output
REQUEST_TIMEOUT=30
RATE_LIMIT_SLEEP=0.35
